# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# MQTT broker (usually the Pi's IP or localhost on Pi)
MQTT_BROKER=localhost
MQTT_PORT=1883

# Optional MQTT auth (leave blank if broker has no auth)
MQTT_USER=
MQTT_PASS=

# Flask ingest server bind address / port
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Enable Flask debug mode for local development (set to true / false)
FLASK_DEBUG=false

# Paths (relative or absolute). Defaults work if you run from inf2009_proj/.
MODEL_STORE_DIR=model_store
CSI_DATA_DIR=csi_data
